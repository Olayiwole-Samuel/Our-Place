# ─────────────────────────────────────────────────────────────────────────────
# Our Place — environment variables
#
# Copy to .env.local for local development. .env.local is git-ignored;
# never commit real values. In production, set these in Vercel (web app)
# and Render (Colyseus server).
#
# Rule: anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and
# is PUBLIC. Secrets must never carry that prefix.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for any data/auth feature) ───────────────────────────
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
# (Supabase dashboard → Project Settings → API → Project URL). Not a key.
NEXT_PUBLIC_SUPABASE_URL=
# Anon (legacy JWT) or publishable (sb_publishable_…) key. Safe in the browser
# ONLY because every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security. Read exclusively by
# lib/supabase/admin.js (guarded by `server-only`). Not used in Phase 2 —
# pairing runs as the signed-in user. Leave empty until a feature needs it.
SUPABASE_SERVICE_ROLE_KEY=

# ── MetaPerson (optional — photo-based characters) ────────────────────────
# SERVER ONLY. From an Avatar SDK "Client Access" application
# (accounts.avatarsdk.com/developer). Leave empty until you subscribe: the app
# then offers the built-in studio, the gallery and .glb imports, and shows
# "Start from a photo" as not available yet.
METAPERSON_CLIENT_ID=
METAPERSON_CLIENT_SECRET=
# Optional, comma-separated hostnames exported models may be downloaded from.
# Default: avatarsdk.com and its subdomains.
# METAPERSON_EXPORT_HOSTS=

# ── Voice ───────────────────────────────────────────────────────────────────
# Which voice system to use (public):
#   p2p   (default) direct browser-to-browser WebRTC — free; signaling over the
#         couple's private Supabase channel (migration 20261008000000).
#   daily Daily.co rooms — needs DAILY_API_KEY and a Daily account with a
#         payment method on file.
# NEXT_PUBLIC_VOICE_PROVIDER=p2p
#
# Daily.co
# REST API key — SERVER ONLY (dashboard.daily.co → Developers → API key; 64 hex
# characters). Used by /api/voice/token to create each couple's private room and
# mint short-lived meeting tokens. Without it, voice shows "isn't set up yet".
DAILY_API_KEY=

# ── Reserved for later phases (not read by any code yet) ────────────────────
# Names are fixed now so every phase uses the same ones.
#
# Colyseus multiplayer server URL (public; e.g. wss://our-place-rt.onrender.com)
# NEXT_PUBLIC_COLYSEUS_URL=
#
# Google Gemini API key — SERVER ONLY, used for AI-generated questions.
# GEMINI_API_KEY=
